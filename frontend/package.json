{
  "name": "cleanhome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev:customer": "npm run dev --workspace=@cleanhome/customer",
    "dev:staff": "npm run dev --workspace=@cleanhome/staff",
    "dev:admin": "npm run dev --workspace=@cleanhome/admin",
    "build:customer": "npm run build --workspace=@cleanhome/customer",
    "build:staff": "npm run build --workspace=@cleanhome/staff",
    "build:admin": "npm run build --workspace=@cleanhome/admin",
    "start:customer": "npm run start --workspace=@cleanhome/customer",
    "start:staff": "npm run start --workspace=@cleanhome/staff",
    "start:admin": "npm run start --workspace=@cleanhome/admin",
    "typecheck:customer": "npm run typecheck --workspace=@cleanhome/customer",
    "typecheck:staff": "npm run typecheck --workspace=@cleanhome/staff",
    "typecheck:admin": "npm run typecheck --workspace=@cleanhome/admin",
    "build": "npm run build:customer && npm run build:staff && npm run build:admin",
    "typecheck": "npm run typecheck:customer && npm run typecheck:staff && npm run typecheck:admin"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
