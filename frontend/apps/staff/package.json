{
  "name": "@cleanhome/staff",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "auth:init": "node --env-file-if-exists=.env.local scripts/init-auth.mjs",
    "test:auth": "node --test --test-concurrency=1 test/auth-core.test.mjs test/auth-http.test.mjs test/auth-ui.test.mjs",
    "test:auth:http": "node --test test/auth-http.integration.test.mjs",
    "test:auth:lifecycle": "node --test --test-concurrency=1 test/auth-lifecycle.integration.test.mjs",
    "test:auth:browser": "node test/auth-browser.integration.mjs",
    "test:jobs": "node --test --test-concurrency=1 test/jobs-contract.test.mjs test/jobs-http.test.mjs test/jobs-ui.test.mjs",
    "test:jobs:http": "node --test --test-concurrency=1 test/jobs-http.integration.test.mjs",
    "test:jobs:lifecycle": "node --test --test-concurrency=1 test/jobs-lifecycle.integration.test.mjs",
    "test:jobs:browser": "node test/jobs-browser.integration.mjs",
    "test:job-detail": "node --test --test-concurrency=1 test/job-detail-contract.test.mjs test/job-detail-http.test.mjs test/job-detail-ui.test.mjs",
    "test:job-detail:http": "node --test --test-concurrency=1 test/job-detail-http.integration.test.mjs",
    "test:job-detail:browser": "node test/job-detail-browser.integration.mjs",
    "test:schedule": "node --test --test-concurrency=1 test/schedule-contract.test.mjs test/schedule-http.test.mjs test/schedule-ui.test.mjs",
    "test:schedule:http": "node --test --test-concurrency=1 test/schedule-http.integration.test.mjs",
    "test:schedule:browser": "node test/schedule-browser.integration.mjs",
    "test:status": "node --test --test-concurrency=1 test/status-contract.test.mjs test/status-store.test.mjs test/status-core.test.mjs test/status-http.test.mjs test/status-ui.test.mjs",
    "test:status:http": "node --test --test-concurrency=1 test/status-http.integration.test.mjs",
    "test:status:browser": "node test/status-browser.integration.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
