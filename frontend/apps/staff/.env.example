# Server-only Staff BFF. Do not add MYSQL_*, Auth private keys or Order credentials.
AUTH_SERVICE_URL=http://127.0.0.1:4001
STAFF_SERVICE_URL=http://127.0.0.1:4005
STAFF_API_TIMEOUT_MS=8000
# UC12 can wait for the Staff -> Order transaction; server-only, maximum 30000.
STAFF_STATUS_TIMEOUT_MS=20000
STAFF_APP_ORIGIN=http://localhost:3002
STAFF_AUTH_TIMEOUT_MS=5000
# Legacy sessions only: bounded by the real Auth token. Renewable sessions use
# the policy below after Auth refresh has been explicitly initialized/configured.
STAFF_SESSION_MAX_AGE_SECONDS=3600
# Server-only renewal. Never put the BFF client credential in NEXT_PUBLIC_*.
# Keep disabled until Auth's refresh:init has initialized its durable private store.
STAFF_SESSION_RENEWAL_ENABLED=false
AUTH_SERVICE_BFF_TOKEN=
# Empty selects 7 days in local/QA, 30 minutes in production.
STAFF_SESSION_IDLE_SECONDS=
# Empty selects a 7-day absolute cap in local/QA, 8 hours in production.
# Production rejects 0 and requires HTTPS plus absolute durable private paths.
STAFF_SESSION_ABSOLUTE_SECONDS=
STAFF_SESSION_REFRESH_BEFORE_SECONDS=60
# Development paths; production requires explicit absolute persistent private paths.
STAFF_SESSION_DIR=.auth-data/sessions
STAFF_SESSION_KEY_FILE=.auth-data/session.key

# Development-only interactive demos. Ignored in production; each flag is independent.
STAFF_INCOME_DEMO_ENABLED=false
STAFF_AREAS_DEMO_ENABLED=false
STAFF_ACHIEVEMENTS_DEMO_ENABLED=false
STAFF_SUPPORT_DEMO_ENABLED=false
STAFF_SETTINGS_DEMO_ENABLED=false

# Leaflet: no Google key or billing. Tiles load only when the map is opened.
# Local/QA defaults to the canonical OSM raster endpoint; production requires an
# explicit tile URL and a provider/self-hosted service suitable for its traffic.
# Every value below is browser-visible. Never put a server credential here.
STAFF_MAPS_ENABLED=true
STAFF_MAP_TILE_URL=
STAFF_MAP_TILE_MAX_ZOOM=19
STAFF_MAP_TILE_PROVIDER_NAME=
STAFF_MAP_TILE_PROVIDER_URL=

# Review API stays off until the real current-employee contract is provided.
STAFF_REVIEWS_API_ENABLED=false

# Server-only AI. Disabled until provider/model, costs and FAQ v2 policy are approved.
# PROVIDER: gateway (legacy internal contract) or openai-compatible (Chat Completions).
# ENDPOINT is the complete HTTPS POST URL. MODEL is required for openai-compatible.
STAFF_SUPPORT_AI_ENABLED=false
STAFF_SUPPORT_AI_PROVIDER=
STAFF_SUPPORT_AI_POLICY_VERSION=
STAFF_SUPPORT_AI_ENDPOINT=
STAFF_SUPPORT_AI_API_KEY=
STAFF_SUPPORT_AI_MODEL=
STAFF_SUPPORT_AI_MAX_OUTPUT_TOKENS=512
STAFF_SUPPORT_AI_TIMEOUT_MS=10000
# Separate approval for filtered free text + short session context; FAQ approval is insufficient.
STAFF_SUPPORT_AI_FREE_TEXT_ENABLED=false
STAFF_SUPPORT_AI_FREE_TEXT_POLICY_VERSION=
# Only qa/staff runtime opts into 30 turns on a development loopback origin.
# Production always retains the default 10 turns, even if these flags are set.
STAFF_SUPPORT_AI_QA_ISOLATED=false
STAFF_SUPPORT_AI_QA_MAX_TURNS=10

# Public navigation links only.
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3001
NEXT_PUBLIC_STAFF_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
