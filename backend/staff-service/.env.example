# Copy to .env and fill values locally. Node >=22: npm start uses --env-file-if-exists=.env.
PORT=4005
CORS_ORIGINS=http://localhost:3002

# Configure an existing MySQL 8.0+ instance; migrations never run automatically on startup.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECTION_LIMIT=10

# Obtain the issuer/audience and real verification key from the team's Auth Service.
# HS256 requires JWT_SECRET >=32 bytes. Do not use both HS256 and RS256 keys.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=RS256
JWT_SECRET=
# RS256: set exactly one of JWKS URL and PEM public key (literal \n is accepted).
JWT_JWKS_URL=
JWT_PUBLIC_KEY=
# Optional GET contract: Authorization Bearer <access token>; response {sub,role,active,locked?}.
# Leaving this unset means revocation/lock status is checked via verified JWT claims and employee state only.
AUTH_INTROSPECTION_URL=

# Order Service is a real dependency. No fake sync succeeds when this is missing.
ORDER_SERVICE_URL=
ORDER_SERVICE_TOKEN=
ORDER_SERVICE_TIMEOUT_MS=5000
# Enable only once Order Service implements the documented internal REST contracts.
RECONCILIATION_WORKER_ENABLED=false
RECONCILIATION_WORKER_INTERVAL_MS=5000
RECONCILIATION_WORKER_BATCH_SIZE=20

# Optional READ-ONLY integration test on an existing development/test database.
# Set true only after MYSQL_* is configured. No fixture or schema is imported.
RUN_MYSQL_TESTS=false
TEST_STAFF_USER_ID=

# Manual-only multi-employee fixture: databases/seed_staff_test_multi.sql.
# Never enable until the user has applied the reviewed SQL in cleanhome_staff_test.
RUN_MYSQL_MULTI_TESTS=false

# Real HTTP tests need a running Staff server and RS256 tokens from Auth Service.
# These flags belong to the test runner; they do not bypass runtime authentication.
RUN_STAFF_HTTP_TESTS=false
RUN_STAFF_HTTP_WRITE_TESTS=false
# Write tests consume ONLY the shared fixture. Explicit confirmation: 9109131.
STAFF_HTTP_WRITE_BOOKING_ID=
STAFF_HTTP_BASE_URL=http://127.0.0.1:4005
STAFF_HTTP_TIMEOUT_MS=8000
# Use exactly one source per token; prefer ignored local files under secrets/.
# Keep all credential values out of this public template and command-line arguments.
STAFF_HTTP_TOKEN_A=
STAFF_HTTP_TOKEN_A_FILE=
STAFF_HTTP_TOKEN_B=
STAFF_HTTP_TOKEN_B_FILE=
STAFF_HTTP_TOKEN_CUSTOMER=
STAFF_HTTP_TOKEN_CUSTOMER_FILE=
