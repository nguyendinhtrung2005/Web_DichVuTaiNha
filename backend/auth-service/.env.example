# Copy only if .env does not exist. Fill credentials locally; never commit them.
PORT=4001
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cleanhome_staff_test
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5

# Public identifiers, not secrets. Agree the same values with Staff Service.
JWT_ISSUER=http://localhost:4001
JWT_AUDIENCE=cleanhome-staff-api
JWT_KEY_ID=cleanhome-local-1
JWT_PRIVATE_KEY_FILE=secrets/auth-private.pem
JWT_ACCESS_TTL_SECONDS=900

# Test-only opt-ins: no automatic schema/seed/password changes at startup.
AUTH_PROVISION_TEST_ACCOUNTS=false
RUN_AUTH_MYSQL_TESTS=false
RUN_AUTH_LIVE_TESTS=false
AUTH_TEST_BASE_URL=http://127.0.0.1:4001
RUN_AUTH_STAFF_HTTP_TESTS=false
AUTH_TEST_STAFF_BASE_URL=http://127.0.0.1:4005
