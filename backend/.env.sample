# Browser origin and public gateway; use localhost consistently in the browser.
CUSTOMER_ORIGIN=http://localhost:3001
STAFF_ORIGIN=http://localhost:3002
ADMIN_ORIGIN=http://localhost:3003
API_HOST=127.0.0.1
GATEWAY_PORT=4000
AUTH_PORT=4001
