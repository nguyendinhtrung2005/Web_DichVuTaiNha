HOST=127.0.0.1
PORT=4003
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=cleanhome_staff_test
MYSQL_CONNECTION_LIMIT=5

# Exactly one real service credential source; NEVER use a user's JWT here.
ORDER_SERVICE_TOKEN=
ORDER_SERVICE_TOKEN_FILE=secrets/staff-service.token

# Tests only: default off. Write tests create labelled test fixtures and retain them.
RUN_ORDER_MYSQL_TESTS=false
RUN_ORDER_LIVE_TESTS=false
RUN_ORDER_RECOVERY_TESTS=false
RUN_ORDER_CONCURRENT_TESTS=false
ORDER_TEST_ALLOW_FIXTURE_WRITES=false
ORDER_LIVE_CONSUME_SHARED_BOOKING=
ORDER_TEST_BASE_URL=http://127.0.0.1:4003
ORDER_LIVE_BASE_URL=http://127.0.0.1:4003
ORDER_LIVE_STAFF_URL=http://127.0.0.1:4005
ORDER_LIVE_AUTH_URL=http://127.0.0.1:4001
AUTH_TEST_BASE_URL=http://127.0.0.1:4001
JWT_ISSUER=http://localhost:4001
JWT_AUDIENCE=cleanhome-staff-api
